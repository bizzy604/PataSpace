# Purpose: Pin line endings so files that Linux executes are never checked out
#   with CRLF.
# Why important: This repo is developed on Windows with core.autocrlf=true. A
#   shell script checked out with \r\n fails on the VPS with the useless error
#   "bad interpreter: /usr/bin/env bash^M", and systemd silently mis-parses unit
#   directives. Deploy scripts are exactly the files where that must never
#   happen, so the rule is enforced here instead of relying on local git config.
# Used by: git, on every checkout. Enforced by infra/deploy/tests/gate.test.mjs.

# Sensible default: let git normalize text, detect binary automatically.
* text=auto

# --- Must be LF: executed or parsed by Linux ---
*.sh        text eol=lf
*.bash      text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.socket    text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.env.*      text eol=lf
Makefile    text eol=lf

# --- Must stay CRLF: Windows-native ---
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Binary: never touch, never diff ---
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.keystore  binary
*.jks       binary

# --- Generated: collapse in PR diffs ---
pnpm-lock.yaml    linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
